msgid "Failed to parse translation response"
msgstr "Error al analizar la respuesta de traducción"

msgid "Translation job failed on server."
msgstr "El trabajo de traducción falló en el servidor."

msgid "Translation context expired. Please retry the translation."
msgstr "El contexto de traducción ha expirado. Por favor, vuelve a intentar la traducción."

msgid "No translatable content found in this page."
msgstr "No se encontró contenido traducible en esta página."

msgid "Translation resulted in invalid Elementor structure."
msgstr "La traducción resultó en una estructura de Elementor no válida."

msgid "No content found in this page."
msgstr "No se encontró contenido en esta página."

msgid "Product not found."
msgstr "Producto no encontrado."

msgid "This product has no translatable content."
msgstr "Este producto no tiene contenido traducible."

msgid "Content type does not support async translation."
msgstr "El tipo de contenido no soporta traducción asíncrona."

msgid "Cannot apply translations: unsupported content type."
msgstr "No se pueden aplicar traducciones: tipo de contenido no soportado."

msgid "You have reached your monthly limit of %1$s words. Free plan users must wait %2$d more days for the limit to reset. Upgrade to a paid plan for immediate access."
msgstr "Has alcanzado tu límite mensual de %1$s palabras. Los usuarios del plan gratuito deben esperar %2$d días más para que se reinicie el límite. Actualiza a un plan de pago para acceso inmediato."

msgid "This translation requires approximately %1$s words, but you only have %2$s words remaining in your plan. Please <a href=\"%3$s\">upgrade your plan</a> or wait for your monthly limit to reset."
msgstr "Esta traducción requiere aproximadamente %1$s palabras, pero solo tienes %2$s palabras restantes en tu plan. Por favor, <a href=\"%3$s\">actualiza tu plan</a> o espera a que se reinicie tu límite mensual."

msgid "This product has no translatable content (no title or short description)."
msgstr "Este producto no tiene contenido traducible (sin título ni descripción corta)."

msgid "You have reached your monthly limit. Free plan users must wait %d more days for the limit to reset."
msgstr "Has alcanzado tu límite mensual. Los usuarios del plan gratuito deben esperar %d días más para que se reinicie el límite."

msgid "This translation requires approximately %s words, but you only have %s words remaining."
msgstr "Esta traducción requiere aproximadamente %s palabras, pero solo tienes %s palabras restantes."

msgid "Original page not found."
msgstr "Página original no encontrada."

