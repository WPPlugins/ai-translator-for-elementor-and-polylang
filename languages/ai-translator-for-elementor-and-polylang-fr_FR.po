msgid "Translation context expired. Please retry the translation."
msgstr "Le contexte de traduction a expiré. Veuillez réessayer la traduction."

msgid "No translatable content found in this page."
msgstr "Aucun contenu traduisible trouvé sur cette page."

msgid "Translation resulted in invalid Elementor structure."
msgstr "La traduction a abouti à une structure Elementor invalide."

msgid "No content found in this page."
msgstr "Aucun contenu trouvé sur cette page."

msgid "Product not found."
msgstr "Produit non trouvé."

msgid "This product has no translatable content."
msgstr "Ce produit n'a aucun contenu traduisible."

msgid "Content type does not support async translation."
msgstr "Le type de contenu ne prend pas en charge la traduction asynchrone."

msgid "Cannot apply translations: unsupported content type."
msgstr "Impossible d'appliquer les traductions : type de contenu non pris en charge."

msgid "You have reached your monthly limit of %1$s words. Free plan users must wait %2$d more days for the limit to reset. Upgrade to a paid plan for immediate access."
msgstr "Vous avez atteint votre limite mensuelle de %1$s mots. Les utilisateurs du plan gratuit doivent attendre %2$d jours de plus pour que la limite se réinitialise. Mettez à niveau vers un plan payant pour un accès immédiat."

msgid "This translation requires approximately %1$s words, but you only have %2$s words remaining in your plan. Please <a href=\"%3$s\">upgrade your plan</a> or wait for your monthly limit to reset."
msgstr "Cette traduction nécessite environ %1$s mots, mais vous n'avez que %2$s mots restants dans votre plan. Veuillez <a href=\"%3$s\">mettre à niveau votre plan</a> ou attendre que votre limite mensuelle se réinitialise."

msgid "This product has no translatable content (no title or short description)."
msgstr "Ce produit n'a aucun contenu traduisible (pas de titre ni de courte description)."

msgid "You have reached your monthly limit. Free plan users must wait %d more days for the limit to reset."
msgstr "Vous avez atteint votre limite mensuelle. Les utilisateurs du plan gratuit doivent attendre %d jours de plus pour que la limite se réinitialise."

msgid "This translation requires approximately %s words, but you only have %s words remaining."
msgstr "Cette traduction nécessite environ %s mots, mais vous n'avez que %s mots restants."

msgid "Original page not found."
msgstr "Page d'origine non trouvée."

