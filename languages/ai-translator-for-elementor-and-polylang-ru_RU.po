msgid "If Meep AI Translator is helpful, please take a moment to rate us on WordPress.org! Your 5-star review helps us grow and keep improving."
msgstr "Если Meep AI Translator полезен, пожалуйста, уделите минуту, чтобы оценить нас на WordPress.org! Ваш отзыв на 5 звезд помогает нам расти и продолжать улучшаться."

msgid "Meep AI Translator — TranslatePress Detected"
msgstr "Meep AI Translator — Обнаружен TranslatePress"

msgid "TranslatePress uses a fundamentally different translation approach (single-post with inline replacements) that is not compatible with this plugin. Meep AI Translator works with duplicate-post translation systems."
msgstr "TranslatePress использует принципиально другой подход к переводу (один пост с встроенными заменами), который несовместим с этим плагином. Meep AI Translator работает с системами перевода дублированных постов."

msgid "<strong>Supported systems:</strong> Polylang, WPML, or our Built-in Language System (recommended — includes menu and widget translation)."
msgstr "<strong>Поддерживаемые системы:</strong> Polylang, WPML или наша встроенная языковая система (рекомендуется — включает перевод меню и виджетов)."

msgid "None"
msgstr "Нет"

msgid "No multilingual plugin is active."
msgstr "Ни один многоязычный плагин не активен."

msgid "Empty translation response"
msgstr "Пустой ответ перевода"

msgid "Invalid JSON format (strict)"
msgstr "Неверный формат JSON (строгий)"

msgid "Failed to parse translation response"
msgstr "Не удалось разобрать ответ перевода"

msgid "Translation job failed on server."
msgstr "Задача перевода не удалась на сервере."

msgid "Translation context expired. Please retry the translation."
msgstr "Контекст перевода истек. Пожалуйста, повторите попытку перевода."

msgid "No translatable content found in this page."
msgstr "Не найдено переводимого контента на этой странице."

msgid "Translation resulted in invalid Elementor structure."
msgstr "Перевод привел к недопустимой структуре Elementor."

msgid "No content found in this page."
msgstr "Контент на этой странице не найден."

msgid "Product not found."
msgstr "Продукт не найден."

msgid "This product has no translatable content."
msgstr "У этого продукта нет переводимого контента."

msgid "Content type does not support async translation."
msgstr "Тип контента не поддерживает асинхронный перевод."

msgid "Cannot apply translations: unsupported content type."
msgstr "Не удается применить переводы: неподдерживаемый тип контента."

msgid "You have reached your monthly limit of %1$s words. Free plan users must wait %2$d more days for the limit to reset. Upgrade to a paid plan for immediate access."
msgstr "Вы достигли своего ежемесячного лимита в %1$s слов. Пользователи бесплатного плана должны подождать еще %2$d дней, чтобы лимит сбросился. Обновите до платного плана для немедленного доступа."

msgid "This translation requires approximately %1$s words, but you only have %2$s words remaining in your plan. Please <a href=\"%3$s\">upgrade your plan</a> or wait for your monthly limit to reset."
msgstr "Этот перевод требует примерно %1$s слов, но у вас осталось только %2$s слов в вашем плане. Пожалуйста, <a href=\"%3$s\">обновите свой план</a> или подождите, пока ваш ежемесячный лимит сбросится."

msgid "This product has no translatable content (no title or short description)."
msgstr "У этого продукта нет переводимого контента (нет заголовка или краткого описания)."

msgid "You have reached your monthly limit. Free plan users must wait %d more days for the limit to reset."
msgstr "Вы достигли своего ежемесячного лимита. Пользователи бесплатного плана должны подождать еще %d дней, чтобы лимит сбросился."

msgid "This translation requires approximately %s words, but you only have %s words remaining."
msgstr "Этот перевод требует примерно %s слов, но у вас осталось только %s слов."

msgid "Original page not found."
msgstr "Оригинальная страница не найдена."

