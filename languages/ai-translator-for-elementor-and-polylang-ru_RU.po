msgstr "Движок перевода недоступен. Пожалуйста, перезагрузите страницу и попробуйте снова."

msgid "Bulk translation started for %1$d pages to %2$d languages."
msgstr "Массовый перевод начат для %1$d страниц на %2$d языков."

msgid "Missing proxy_job_id."
msgstr "Отсутствует proxy_job_id."

msgid "Job ID is required."
msgstr "Идентификатор задания обязателен."

msgid "Translation paused successfully."
msgstr "Перевод успешно приостановлен."

msgid "Translation resumed successfully."
msgstr "Перевод успешно возобновлен."

msgid "Translation cancelled successfully."
msgstr "Перевод успешно отменен."

msgid "You do not have permission to publish pages."
msgstr "У вас нет разрешения на публикацию страниц."

msgid "4 translations published successfully."
msgstr "4 перевода успешно опубликованы."

msgid "Pages are required."
msgstr "Страницы обязательны."

msgid "Translation queued and waiting to start..."
msgstr "Перевод поставлен в очередь и ожидает начала..."

msgid "Translation in progress... %d%% completed"
msgstr "Перевод в процессе... %d%% завершено"

msgid "Translation failed. Please check the error details."
msgstr "Перевод не удался. Пожалуйста, проверьте детали ошибки."

msgid "Translation was cancelled."
msgstr "Перевод был отменен."

msgid "Unknown status."
msgstr "Неизвестный статус."

msgid "Cron triggered successfully."
msgstr "Cron успешно запущен."

msgid "You are in a monthly cooldown period. Your translation limit will reset in %d days. Upgrade your plan to continue translating immediately."
msgstr "Вы находитесь в месячном периоде ожидания. Ваш лимит перевода будет сброшен через %d дней. Обновите свой план, чтобы продолжить перевод немедленно."

msgid "Word limit reached! You have used all %1$s words in your %2$s plan. Upgrade to continue or wait for the monthly reset period."
msgstr "Достигнут лимит слов! Вы использовали все %1$s слов в вашем %2$s плане. Обновите, чтобы продолжить, или дождитесь окончания месячного периода сброса."

msgid "Not enough words remaining. This translation requires approximately %1$s words, but you only have %2$s words left in your %3$s plan."
msgstr "Недостаточно оставшихся слов. Этот перевод требует примерно %1$s слов, но у вас осталось только %2$s слов в вашем %3$s плане."

msgid "Built-in language system is not active."
msgstr "Встроенная языковая система не активна."

