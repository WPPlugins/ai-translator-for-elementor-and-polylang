msgstr "Не найдено активных шаблонов Elementor для перевода."

msgid "No advanced Elementor templates found to translate."
msgstr "Не найдено продвинутых шаблонов Elementor для перевода."

msgid "%d template(s) to translate, %d already done."
msgstr "%d шаблон(ов) для перевода, %d уже переведено."

msgid "🔄 %s — re-translating (old translation removed)"
msgstr "🔄 %s — повторный перевод (старый перевод удален)"

